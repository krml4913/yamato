#!/usr/bin/env python3
"""yamato CLI entrypoint.

Adds ``src/`` and ``vendor/`` to ``sys.path`` so the package runs without
``pip install``. The real work lives in ``src/yamato/cli.py``.
"""
from __future__ import annotations

import os
import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(_HERE / "src"))
sys.path.insert(0, str(_HERE / "vendor"))


def _run_quiet_on_broken_pipe(func) -> int:
    """Run ``func`` and turn a closed stdout (``yamato status | head``) into a
    quiet exit instead of a BrokenPipeError traceback (the standard library's
    documented SIGPIPE idiom: https://docs.python.org/3/library/signal.html).

    Each command keeps printing normally; only the entry point catches it.
    """
    try:
        rc = func()
        sys.stdout.flush()
        return rc if isinstance(rc, int) else 0
    except BrokenPipeError:
        # Redirect stdout to devnull so the interpreter's own shutdown flush
        # (which would otherwise print "Exception ignored on flushing
        # sys.stdout") has nowhere left to fail.
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        os.close(devnull)
        return 141  # 128 + SIGPIPE, the shell's usual convention


if __name__ == "__main__" and sys.argv[1:3] == ["hook", "pre-tool-use"] and len(sys.argv) == 5:
    # before every tool call of every seat: skip the CLI (yamato.pretool)
    from yamato.pretool import main as pre_tool_use  # noqa: E402

    sys.exit(_run_quiet_on_broken_pipe(lambda: pre_tool_use(sys.argv[3], sys.argv[4])))

from yamato.cli import main  # noqa: E402  (sys.path tweak required before import)

if __name__ == "__main__":
    sys.exit(_run_quiet_on_broken_pipe(main))
