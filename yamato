#!/usr/bin/env python3
"""yamato CLI entrypoint.

Adds ``src/`` and ``vendor/`` to ``sys.path`` so the package runs without
``pip install``. The real work lives in ``src/yamato/cli.py``.
"""
from __future__ import annotations

import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(_HERE / "src"))
sys.path.insert(0, str(_HERE / "vendor"))

from yamato.cli import main  # noqa: E402  (sys.path tweak required before import)

if __name__ == "__main__":
    sys.exit(main())
