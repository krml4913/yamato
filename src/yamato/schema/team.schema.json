{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "yamato team.yaml",
  "description": "yamato の艦の定義 (team.yaml)。src/yamato/team.py の validate と揃えてある (tests/test_team_schema.py が項目の集合を照合する)。書式は docs/design.md §5。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "hub",
    "workspace",
    "roles"
  ],
  "properties": {
    "name": {
      "description": "艦の名前。",
      "type": "string"
    },
    "hub": {
      "description": "captain を務める役割 (roles にある、count: 1 の役割)。",
      "type": "string"
    },
    "workspace": {
      "description": "席の作業ディレクトリ (作業対象の repo。repo のない艦は . = 艦フォルダ)。複数の repo を 1 艦で扱うときはパスのリスト (先頭が席の cwd。呼び名はフォルダ名で、かぶったら読み込みエラー)。",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "charter": {
      "description": "何のための艦かを書いたファイル (人間が書く)。省略時 charter.md。",
      "type": "string"
    },
    "talk_default": {
      "description": "yamato talk で席を省いたときに attach する席 (省略時は hub)。",
      "type": "string"
    },
    "up_seats": {
      "description": "yamato up で captain (hub) と一緒に起こす席の名前のリスト (省略時は空 = captain だけ)。up --seats との和 (up_seats → --seats の順、重複と hub は除く)。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "time_limit": {
      "description": "yamato up からの稼働時間 (up --for で上書き)。省略時 3h。`none` は上限なし (admiral 専用)。",
      "anyOf": [
        {
          "const": "none"
        },
        {
          "description": "稼働時間。 「3h」「20m」「1h30m」「90s」のように書く (数だけなら分)。",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\s*(\\d+\\s*[hms]\\s*)+$|^\\s*\\d+\\s*$"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        }
      ]
    },
    "grace": {
      "description": "終業の指示から強制停止までの猶予。省略時 20m。 「3h」「20m」「1h30m」「90s」のように書く (数だけなら分)。",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\s*(\\d+\\s*[hms]\\s*)+$|^\\s*\\d+\\s*$"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "last_call": {
      "description": "最終受付 (design-p1 §9)。deadline の min(at_most, time_limit × ratio) 前に captain へ一度だけ注意を注入する。 `off` で無効。",
      "anyOf": [
        {
          "type": "object",
          "description": "最終受付の設定。",
          "properties": {
            "at_most": {
              "description": "deadline のこの時間前まで。 `off` で無効。",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "off",
                    false,
                    "false",
                    "no"
                  ]
                }
              ]
            },
            "ratio": {
              "description": "time_limit のこの割合 (20% など)。 `off` で無効。",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "off",
                    false,
                    "false",
                    "no"
                  ]
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "enum": [
            "off",
            false,
            "false",
            "no"
          ]
        }
      ]
    },
    "roles": {
      "type": "object",
      "description": "役割の一覧。キーが役割の名前 (owner は予約)。",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "description": "役割 1 つの定義。count が 2 以上なら席は <役割>-1, <役割>-2, ...。",
        "properties": {
          "model": {
            "description": "モデル (sonnet / opus / haiku など)。省略時 sonnet。Haiku は auto モードを使えない (警告)。",
            "type": "string"
          },
          "shift": {
            "description": "シフトの粒度。per_task: タスクごとに起こす / persistent: 常駐 / headless: claude -p 1 回で終わる 1 シフト。省略時 per_task。",
            "enum": [
              "per_task",
              "persistent",
              "headless"
            ]
          },
          "count": {
            "description": "席の数 (1 以上)。hub の役割は 1。",
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "description": "役割の説明 (役割の定義に入る)。",
            "type": "string"
          },
          "inject": {
            "description": "この役割だけの注入の部品 (トップの inject.parts を上書き)。SessionStart で席に読ませるもの (design §8.2)。handoff 引き継ぎ / log_tail 作業ログの末尾 / mine 自分の担当 / inbox 未読 / memory 役割の memory / knowledge 艦の knowledge.md / last_report 前回の日報の抜粋 / orphans 担当が落ちて active のまま残った項目 (captain 用) / board 艦全体の進み具合 / fleet 全艦の要約 (admiral 用)。",
            "type": "array",
            "items": {
              "enum": [
                "handoff",
                "log_tail",
                "mine",
                "inbox",
                "memory",
                "knowledge",
                "last_report",
                "orphans",
                "board",
                "fleet"
              ]
            }
          },
          "max_duration": {
            "description": "headless の 1 シフトの上限 (shift: headless だけで効く)。 「3h」「20m」「1h30m」「90s」のように書く (数だけなら分)。",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\s*(\\d+\\s*[hms]\\s*)+$|^\\s*\\d+\\s*$"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ]
          },
          "max_budget_usd": {
            "description": "headless の 1 シフトの予算 (USD、正の数)。書いたときだけ --max-budget-usd を付ける。",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "report_to": {
            "description": "headless のシフト終了の定型文の報告先 (席の名前か owner。省略時は hub)。",
            "type": "string"
          },
          "trust": {
            "description": "profiles の名前。この役割の権限の組み方 (mode / tools / allow / deny / send) を選ぶ。",
            "type": "string"
          },
          "remote_control": {
            "description": "true でこの席だけ --remote-control を付けて起こす (bg の席だけ)。",
            "type": "boolean"
          },
          "rotate": {
            "type": "object",
            "description": "persistent の席を新しいシフトに入れ替える条件 (design-p1 §5.3, §5.4)。どれも off にできる。",
            "properties": {
              "context": {
                "description": "前のシフトの文脈量がモデルの窓 (context_windows) のこの割合以上なら入れ替える。30% / 0.3 のように割合か、300k のようにトークン数。 `off` で無効。",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "enum": [
                      "off",
                      false,
                      "false",
                      "no"
                    ]
                  }
                ]
              },
              "compaction": {
                "description": "compaction が起きたら入れ替える。",
                "type": "boolean"
              },
              "hours": {
                "description": "シフトの長さ。8h のように書く (数だけなら時間)。 `off` で無効。",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "enum": [
                      "off",
                      false,
                      "false",
                      "no"
                    ]
                  }
                ]
              },
              "idle": {
                "description": "止まってからこれ以上たったら入れ替える (resume はキャッシュ切れで高い)。 `off` で無効。",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "enum": [
                      "off",
                      false,
                      "false",
                      "no"
                    ]
                  }
                ]
              },
              "new_day": {
                "description": "前のシフトの開始から日付が変わったら入れ替える。",
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "object",
      "description": "trust のプロファイル (名前 → 権限の組み方)。",
      "additionalProperties": {
        "type": "object",
        "description": "trust のプロファイル (design-p1 §7.2)。役割の trust: <名前> で選ぶ。",
        "properties": {
          "mode": {
            "description": "permissions.defaultMode (auto / dontAsk など。省略時 auto)。",
            "type": "string"
          },
          "tools": {
            "description": "役割が使えるツールの一覧 (省略時は制限なし)。",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allow": {
            "description": "席の settings の permissions.allow に足すルール。{{ship}} / {{yamato}} / {{seat}} が置き換わる。",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deny": {
            "description": "席の settings の permissions.deny に足すルール。",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "send": {
            "description": "false にすると、その席からの yamato send を断る。",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "watch": {
      "type": "object",
      "description": "yamato status / ships で赤く出す目安 (design-p1 §5.2)。記録と警告だけで、拒否はしない。",
      "properties": {
        "stale_after": {
          "description": "生きているのに最後に動いてからこれより長い席を赤にする。省略時 20m。 「3h」「20m」「1h30m」「90s」のように書く (数だけなら分)。",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\s*(\\d+\\s*[hms]\\s*)+$|^\\s*\\d+\\s*$"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "captain_gap": {
          "description": "captain が止まったまま起きていない時間がこれを超えたら events に captain_gap。 `off` で無効。",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "enum": [
                "off",
                false,
                "false",
                "no"
              ]
            }
          ]
        },
        "orphan_after": {
          "description": "active の項目の担当がこれ以上止まっていたら captain の注入に孤児と出す。 `off` で無効。",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "enum": [
                "off",
                false,
                "false",
                "no"
              ]
            }
          ]
        },
        "spin": {
          "description": "空回りの疑いの検出 (events に残し、送り手に警告)。 `off` で無効。",
          "anyOf": [
            {
              "type": "object",
              "description": "spin の設定。",
              "properties": {
                "window": {
                  "description": "見る時間の幅 (10m など)。",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "max_sends": {
                  "description": "同じ送り手 → 宛先が window にこれより多いと疑う。 `off` で無効。",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "enum": [
                        "off",
                        false,
                        "false",
                        "no"
                      ]
                    }
                  ]
                },
                "same_text": {
                  "description": "同じ本文を続けて送ったら疑う。",
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "enum": [
                "off",
                false,
                "false",
                "no"
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "context_windows": {
      "type": "object",
      "description": "モデル名 (の一部) → 文脈の窓のトークン数 (rotate.context の割合の分母)。長く一致したものを使う。",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "deny": {
      "description": "無人の席にやらせない操作 (Claude Code の permissions.deny)。安全網の既定値で、艦ごとに変えてよい。{{ship}} は艦フォルダのパスに置き換わる。ask ルールは auto でも止まるので使わない。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env_unset": {
      "description": "席の起動から外す環境変数の名前 (既定は空)。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "setting_sources": {
      "description": "席に読ませる Claude Code の設定の出どころ (--setting-sources に渡す)。既定は [project, local]。user を足すと ~/.claude の CLAUDE.md だけでなく hooks・plugin・env・remoteControlAtStartup なども席に入る (design §4.1)。",
      "type": "array",
      "items": {
        "enum": ["user", "project", "local"]
      },
      "minItems": 1,
      "uniqueItems": true,
      "default": ["project", "local"]
    },
    "settings": {
      "type": "object",
      "description": "席の settings.json に重ねる中身 (Claude Code の settings)。",
      "additionalProperties": true
    },
    "seat_stop": {
      "type": "object",
      "description": "seat-stop が終業前に確かめること (§8.3)。",
      "properties": {
        "require_handoff": {
          "description": "handoff.md が今回のシフトで更新されていること。",
          "type": "boolean"
        },
        "require_delivery": {
          "description": "生きている宛先への送信が読まれているか、--delivered が付いていること。",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "inject": {
      "type": "object",
      "description": "SessionStart で席に読ませるもの (design §8.2)。",
      "properties": {
        "parts": {
          "description": "注入する部品 (役割ごとに roles.<role>.inject で上書き)。SessionStart で席に読ませるもの (design §8.2)。handoff 引き継ぎ / log_tail 作業ログの末尾 / mine 自分の担当 / inbox 未読 / memory 役割の memory / knowledge 艦の knowledge.md / last_report 前回の日報の抜粋 / orphans 担当が落ちて active のまま残った項目 (captain 用) / board 艦全体の進み具合 / fleet 全艦の要約 (admiral 用)。",
          "type": "array",
          "items": {
            "enum": [
              "handoff",
              "log_tail",
              "mine",
              "inbox",
              "memory",
              "knowledge",
              "last_report",
              "orphans",
              "board",
              "fleet"
            ]
          }
        },
        "limits": {
          "type": "object",
          "description": "注入の上限。超えた分は切って「全文は <パス> を Read せよ」と書く。memory と knowledge は memory.limits で切る。",
          "properties": {
            "handoff": {
              "description": "上限。正の整数か [行数, 文字数]。",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer"
                  }
                }
              ]
            },
            "log_tail": {
              "description": "上限。正の整数か [行数, 文字数]。",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer"
                  }
                }
              ]
            },
            "mine_items": {
              "description": "担当の項目数の上限。",
              "type": "integer",
              "minimum": 1
            },
            "inbox_messages": {
              "description": "inbox の通数の上限。",
              "type": "integer",
              "minimum": 1
            },
            "inbox_chars": {
              "description": "1 通あたりの文字数。",
              "type": "integer",
              "minimum": 1
            },
            "total_chars": {
              "description": "hook 1 本の全体の文字数 (Claude Code は 1 本 1 万文字まで)。",
              "type": "integer",
              "minimum": 1
            },
            "last_report": {
              "description": "上限。正の整数か [行数, 文字数]。",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer"
                  }
                }
              ]
            },
            "board_items": {
              "description": "board の部品の項目数の上限。",
              "type": "integer",
              "minimum": 1
            },
            "fleet_items": {
              "description": "fleet の部品の項目数の上限。",
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "description": "memory の棚卸し (design-p1 §3)。役割の memory は roles/<役割>/memory.md。",
      "properties": {
        "applier": {
          "description": "反映を打つ役割 (省略時は hub)。",
          "type": "string"
        },
        "curate_every": {
          "description": "前回の反映からこの日数が経ったら棚卸しの目安 (7d。数だけなら日)。",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "curate_at": {
          "description": "候補がこの件数に達したら棚卸しの目安。",
          "type": "integer",
          "minimum": 1
        },
        "max_duration": {
          "description": "棚卸しのシフト 1 回の上限。 「3h」「20m」「1h30m」「90s」のように書く (数だけなら分)。",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\s*(\\d+\\s*[hms]\\s*)+$|^\\s*\\d+\\s*$"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "limits": {
          "type": "object",
          "description": "memory apply が反映を拒否する上限。注入もこれで切る。",
          "properties": {
            "memory_lines": {
              "description": "役割の memory の行数。",
              "type": "integer",
              "minimum": 1
            },
            "memory_chars": {
              "description": "役割の memory の文字数。",
              "type": "integer",
              "minimum": 1
            },
            "knowledge_lines": {
              "description": "knowledge.md の行数。",
              "type": "integer",
              "minimum": 1
            },
            "knowledge_chars": {
              "description": "knowledge.md の文字数。",
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "notify": {
      "type": "object",
      "description": "owner 宛ての send の通知経路 (design-p1 §2.4)。",
      "properties": {
        "via": {
          "description": "送る方式 (複数可、省略なら通知しない)。slack: incoming webhook / mac: macOS 通知 / windows: toast / command: 下の command を実行。",
          "type": "array",
          "items": {
            "enum": [
              "slack",
              "mac",
              "windows",
              "command"
            ]
          }
        },
        "slack": {
          "type": "object",
          "description": "slack の設定。",
          "properties": {
            "webhook_env": {
              "description": "webhook の URL が入った環境変数の名前 (URL は艦フォルダに書かない)。",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "command": {
          "description": "via に command を入れたときに実行するシェルのコマンド。件名・本文・重要度は stdin の JSON と YAMATO_TITLE / YAMATO_MESSAGE / YAMATO_LEVEL で渡る。",
          "type": "string"
        },
        "decisions": {
          "description": "人間が decider の判断の通知。digest: 日報にまとめる / each: 1 件ずつ。",
          "enum": [
            "digest",
            "each"
          ]
        }
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "object",
      "description": "判断 (yamato decide) の種類と決める人 (design-p1 §1.4)。開いた時点で decider が決まる。",
      "additionalProperties": {
        "description": "判断の種類 (category) の decider。席の名前か owner (人間)。表にない category は default に落ちる。",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "description": "decider と、いつ開くかの説明。",
            "properties": {
              "decider": {
                "description": "決める人。席の名前か owner。",
                "type": "string"
              },
              "when": {
                "description": "役割プロンプトの「いつ判断を開くか」の説明。",
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "decider"
            ]
          }
        ]
      }
    },
    "git": {
      "type": "object",
      "description": "git の道具 (yamato worktree / pr) の設定 (design-p1 §8.3)。",
      "properties": {
        "base": {
          "description": "worktree add の既定の起点と PR の base。",
          "type": "string"
        },
        "strategy": {
          "description": "pr merge のやり方。",
          "enum": [
            "squash",
            "merge",
            "rebase"
          ]
        },
        "merge_requires": {
          "description": "pr merge の前に確かめること。review: review=approved がある / ci: gh pr checks が通る / decision: merge の判断が閉じている。[] で確かめない。",
          "type": "array",
          "items": {
            "enum": [
              "review",
              "ci",
              "decision"
            ]
          }
        },
        "conflict": {
          "description": "merge のあとに衝突した PR を知らせる先。author (項目の assignee) か席の名前。",
          "type": "string"
        },
        "merge_decision": {
          "description": "外れた項目 (D-021)。無視される。消す。",
          "deprecationMessage": "git.merge_decision は外れた (D-021)。無視されるので消す。"
        }
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "description": "日報 (design-p1 §2)。",
      "properties": {
        "daily": {
          "description": "on_down: down・強制停止のとき日報が無ければ事実だけの日報を作って通知する / off: 安全網で作らない。",
          "anyOf": [
            {
              "enum": [
                "on_down",
                "off"
              ]
            },
            {
              "const": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "description": "board の設定 (§6.2)。",
      "properties": {
        "archive_on_done": {
          "description": "done になった項目を board/archive/ に移す (false なら board archive で手で移す)。",
          "type": "boolean"
        },
        "kinds": {
          "description": "項目の種類。最初の値が board add の既定。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "description": "目安の項目名 (board は固定項目以外を検証しない)。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "columns": {
          "description": "kanban の列。state は固定の 4 つに対応させる。",
          "type": "array",
          "items": {
            "type": "object",
            "description": "列。",
            "properties": {
              "name": {
                "description": "列の名前。",
                "type": "string"
              },
              "state": {
                "description": "対応する state。",
